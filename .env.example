# Frontend env. Copy to .env.local. Vite only exposes VITE_*-prefixed vars to the client.

# Gemini key. Bundled into the build — UNSAFE for production.
# In production, leave this empty and set VITE_API_BASE_URL to your backend.
GEMINI_API_KEY=

# Backend base URL. When set, the app routes Gemini Live through the proxy,
# uses the LiveKit token endpoint, and points the per-user auth service
# (register / login / refresh / me) at this host. Leave empty for local-only
# mode (mock voice transport + skipped auth boot validation).
VITE_API_BASE_URL=

# Optional. Shared bearer token used for backend-to-backend or trusted-
# client calls that bypass the per-user auth flow. The app does NOT send
# this from the AuthView — end users authenticate via /api/auth/login.
# Only set this if you have a legacy integration that needs to hit
# privileged endpoints (e.g. /api/voice/token) without a user JWT.
VITE_APP_SECRET=

# Which voice transport to use.
# 'mock'    — local simulator (default, no backend needed)
# 'livekit' — real multi-user via LiveKit (requires VITE_API_BASE_URL + backend
#             with LIVEKIT_* env)
# 'agora'   — stub, not yet implemented
# 语音传输层。**留空 = 语音未启用（no-voice）**，不会产生任何虚拟成员。
#   none    （默认，留空即此）真实无语音，房间只显示后端确认在线的真人
#   mock    仅本地演示：生成虚构远端成员，且 isSpeaking 是随机的。
#           祷告室**不会**使用这些虚拟成员；其余四种房间会。生产环境勿用。
#   livekit / agora  真实语音（还需相应的服务端 key）
VITE_VOICE_TRANSPORT=
