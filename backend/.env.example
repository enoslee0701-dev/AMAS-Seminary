# Copy to .env and fill in your secrets.
# NEVER commit the real .env file.

# Port the server listens on.
PORT=8787

# Shared bearer token between the frontend and this backend. Required in
# production — when set, every privileged API call must include the header
# `Authorization: Bearer <APP_SECRET>` (and the Gemini WS connects with
# `?token=<APP_SECRET>`). Leave blank for local development to disable
# auth — a warning is printed at startup if it's unset.
APP_SECRET=

# JWT signing secret for per-user access + refresh tokens. MUST be a long
# random string in production (≥ 32 bytes of entropy, e.g.
# `openssl rand -hex 48`). When unset, the server derives one from
# APP_SECRET — fine for dev, but a dedicated value is recommended.
JWT_SECRET=

# CORS origins (comma-separated). For local dev:
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# --- Supabase（认证与授权的 Source of Truth，AUTH-M7 之后必填）---
# SUPABASE_URL 一经配置，后端即接受该 project 签发的 access token：
#   按 iss 分流 → 远端 JWKS 验签 → legacy_user_map 解析 canonical 用户。
# **未配置时没有任何用户可以登录**（legacy 自签 token 已删除）。
# 启动日志会打印 `IDENTITY: supabase host=… · service-role key=SET|MISSING`
# 供人眼核对连的是哪个 project（staging 与 production 必须是不同 project，D-40）。
SUPABASE_URL=

# service-role key。只用于服务端现查 user_roles 与 profiles 回落读取，
# **绝不下发到任何客户端**，也绝不放进 VITE_ 变量。
# 缺它 requireAdmin 的角色现查返回空数组 —— 管理员一律 403。
SUPABASE_SERVICE_ROLE_KEY=

# 运行环境。设为 production 时启用 RB-06 生产启动护栏：
# JWT_SECRET / DB_PATH / CORS_ORIGINS 缺失或不合规将拒绝启动。
# staging 建议设为 staging（语义清晰，且不触发生产护栏）。
NODE_ENV=

# 可选。和合本经文数据路径，缺省为 public/scripture/cuv.json。
SCRIPTURE_DATA_PATH=

# --- Gemini Live ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- LiveKit ---
# Sign up at https://cloud.livekit.io (free tier exists).
# After creating a project, copy these three values:
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agora ---
# Sign up at https://console.agora.io (free tier exists). Preferred transport
# for mainland-China users (LiveKit Cloud / AWS is often blocked there).
# After creating a project, enable App ID + App Certificate authentication and
# copy these two values. The App Certificate is a SECRET and must never be
# shipped to the browser — the backend uses it to sign short-lived RTC tokens.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Room password storage (in-memory by default) ---
# For production, replace with Redis / Postgres via ROOM_STORE_URL.
ROOM_STORE_URL=

# --- SQLite persistence (wave-1: users, refresh-token jti, rooms, push tokens) ---
# Path to the better-sqlite3 file. Leave blank to use the default
# `<backend>/data/amas.sqlite` (the directory is created automatically).
# Use `:memory:` for an in-process DB that vanishes on exit (tests use this).
DB_PATH=

# --- Apple Push Notification service (APNs) ---
# All four vars must be set to enable real push delivery. When ANY is
# missing the server boots fine — `/api/push/test` returns a stub and
# broadcast pushes (on new post / announcement) become a silent no-op.
#
# Download the .p8 auth key from
#   https://developer.apple.com/account/resources/authkeys
# and store the absolute path in APNS_KEY_PATH. The Key ID is shown on
# that page after you create the key; the Team ID is at the top of
# Account > Membership.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.amas.seminary
# Set to 'true' to push via the production APNs gateway; leave unset /
# 'false' to use the sandbox (development) gateway. Production builds
# from the App Store / TestFlight need 'true'; Xcode-built debug builds
# need it unset.
APNS_PRODUCTION=false
